# BookCars Flutter — Environment Variables
# 
# Pass these to flutter run / flutter build using --dart-define:
#   flutter run --dart-define=API_HOST=http://10.0.2.2:4002 --dart-define=...
#
# Or create a .env file and use a tool like flutter_dotenv (optional).

# BookCars backend API base URL
# Android emulator localhost: http://10.0.2.2:4002
# iOS simulator localhost:    http://localhost:4002
# Production:                 https://api.yourdomain.com
API_HOST=http://10.0.2.2:4002

# CDN base URLs (from your BookCars backend .env)
CDN_USERS=http://10.0.2.2:4002/cdn/users
CDN_CARS=http://10.0.2.2:4002/cdn/cars
CDN_LICENSES=http://10.0.2.2:4002/cdn/licenses
CDN_TEMP_LICENSES=http://10.0.2.2:4002/cdn/licenses/temp

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_MERCHANT_IDENTIFIER=merchant.com.bookcars
STRIPE_COUNTRY_CODE=US

# Google Sign-In (get from Google Cloud Console)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# App settings
WEBSITE_NAME=BookCars
BASE_CURRENCY=USD
DEPOSIT_FILTER_VALUE_1=1500
DEPOSIT_FILTER_VALUE_2=3000
DEPOSIT_FILTER_VALUE_3=5000

